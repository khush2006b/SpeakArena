# ============================================================
# SpeakArena Frontend — Environment Variables
# Copy to .env.local for development.
# NEVER commit .env.local to version control.
# ============================================================

# --- API ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SpeakArena
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cloudflare R2 Media Storage ---
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# --- Razorpay (public key only — never expose the secret) ---
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# --- Sentry (public DSN — safe to expose) ---
NEXT_PUBLIC_SENTRY_DSN=

# --- Feature flags ---
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

