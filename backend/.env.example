# ============================================================
# SpeakArena Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME=SpeakArena
APP_ENV=development         # development | staging | production
DEBUG=true                  # Set to false in production
SECRET_KEY=change-me-to-a-long-random-secret-at-least-64-chars
ALLOWED_HOSTS=["http://localhost:3000","https://speakarena.com"]

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://speakarena:password@localhost:5432/speakarena_db
DATABASE_SYNC_URL=postgresql+psycopg2://speakarena:password@localhost:5432/speakarena_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-different-long-random-secret-for-jwt
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=speakarena-storage
R2_PUBLIC_URL=https://storage.speakarena.com
R2_PRESIGNED_URL_EXPIRY_UPLOAD=900     # 15 minutes
R2_PRESIGNED_URL_EXPIRY_STREAM=3600    # 1 hour
R2_PRESIGNED_URL_EXPIRY_DOWNLOAD=1800  # 30 minutes

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Email (SMTP) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM_EMAIL=noreply@speakarena.com
SMTP_FROM_NAME=SpeakArena

# --- Sentry ---
SENTRY_DSN=                # Leave empty to disable Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- CORS ---
CORS_ALLOWED_ORIGINS=["http://localhost:3000","https://speakarena.com","https://www.speakarena.com"]

# --- Rate Limiting ---
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=3
RATE_LIMIT_DEFAULT_PER_MINUTE=100
