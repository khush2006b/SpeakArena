# =============================================================================
# SpeakArena Backend — PRODUCTION Environment Variables Template
#
# Copy this to /etc/speakarena/.env.prod and fill in real values.
# NEVER commit .env.prod to version control.
# Permissions: chmod 600 /etc/speakarena/.env.prod
# Owner: root:root (or deployer user)
#
# On GitHub Actions, all secrets marked [GITHUB SECRET] are stored in:
# Repository Settings → Secrets and variables → Actions
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=SpeakArena
APP_ENV=production
DEBUG=false
SECRET_KEY=                    # [GITHUB SECRET] Minimum 64 chars, cryptographically random
ALLOWED_HOSTS=["https://speakarena.com","https://www.speakarena.com","https://api.speakarena.com"]
APP_VERSION=${APP_VERSION}     # Injected by Docker build (git SHA)

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ---------------------------------------------------------------------------
POSTGRES_USER=speakarena
POSTGRES_PASSWORD=             # [GITHUB SECRET] Strong random password
POSTGRES_DB=speakarena_db
DB_HOST=db                     # Docker service name
DB_PORT=5432

DATABASE_URL=postgresql+asyncpg://speakarena:${POSTGRES_PASSWORD}@db:5432/speakarena_db
DATABASE_SYNC_URL=postgresql+psycopg2://speakarena:${POSTGRES_PASSWORD}@db:5432/speakarena_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# ---------------------------------------------------------------------------
# Redis 7
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# ---------------------------------------------------------------------------
# JWT Tokens
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=                # [GITHUB SECRET] Different from SECRET_KEY, min 64 chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------------------------------------------------------------------------
# Cloudflare R2 Storage
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=                 # [GITHUB SECRET] Cloudflare Account ID
R2_ACCESS_KEY_ID=              # [GITHUB SECRET] R2 Access Key
R2_SECRET_ACCESS_KEY=          # [GITHUB SECRET] R2 Secret
R2_BUCKET_NAME=speakarena-storage
R2_PUBLIC_URL=https://storage.speakarena.com
R2_PRESIGNED_URL_EXPIRY_UPLOAD=900
R2_PRESIGNED_URL_EXPIRY_STREAM=3600
R2_PRESIGNED_URL_EXPIRY_DOWNLOAD=1800

# R2 Backup bucket (separate from main storage)
R2_BACKUP_BUCKET=speakarena-backups

# ---------------------------------------------------------------------------
# Razorpay Payment Gateway
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=               # [GITHUB SECRET] rzp_live_xxx
RAZORPAY_KEY_SECRET=           # [GITHUB SECRET]
RAZORPAY_WEBHOOK_SECRET=       # [GITHUB SECRET]

# ---------------------------------------------------------------------------
# Email (SMTP via SendGrid)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=                 # [GITHUB SECRET] SendGrid API key
SMTP_FROM_EMAIL=noreply@speakarena.com
SMTP_FROM_NAME=SpeakArena

# ---------------------------------------------------------------------------
# Google Meet Integration
# ---------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=        # [GITHUB SECRET] Google Cloud OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_SECRET=    # [GITHUB SECRET] Google Cloud OAuth 2.0 Client Secret
GOOGLE_OAUTH_REDIRECT_URI=https://api.speakarena.com/api/v1/meetings/google/callback
GOOGLE_SERVICE_ACCOUNT_JSON=   # [GITHUB SECRET] Google Service Account JSON (base64 encoded)

# ---------------------------------------------------------------------------
# Sentry Error Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=                    # [GITHUB SECRET] Sentry DSN URL
SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% of transactions for performance monitoring
SENTRY_PROFILES_SAMPLE_RATE=0.05
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=${APP_VERSION}

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=["https://speakarena.com","https://www.speakarena.com"]
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=600

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=10
RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR=3
RATE_LIMIT_DEFAULT_PER_MINUTE=100

# ---------------------------------------------------------------------------
# Server / Gunicorn
# ---------------------------------------------------------------------------
GUNICORN_WORKERS=4             # Recommended: 2 × CPU cores
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# ---------------------------------------------------------------------------
# Docker / Deployment
# ---------------------------------------------------------------------------
GITHUB_REPOSITORY=your-org/speakarena
IMAGE_TAG=latest               # Overridden by deploy.sh with git SHA
