# Minimal environment for unit/api tests.
# No real services are contacted — all DB/Redis/R2/Razorpay calls are mocked.
# NEVER use production values here.

APP_NAME=SpeakArena
ENVIRONMENT=test
DEBUG=false
SECRET_KEY=test-secret-key-for-unit-tests-only-32bytes!

DATABASE_URL=postgresql+asyncpg://test:test@localhost:5432/speakarena_test
DATABASE_SYNC_URL=postgresql+psycopg2://test:test@localhost:5432/speakarena_test
REDIS_URL=redis://localhost:6379/15

JWT_SECRET_KEY=test-jwt-secret-key-256-bits-long-for-unit-tests-only!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

R2_ACCOUNT_ID=test-account-id
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_BUCKET_NAME=speakarena-test
R2_PUBLIC_URL=https://test.r2.dev
R2_PRESIGNED_URL_EXPIRY_UPLOAD=3600
R2_PRESIGNED_URL_EXPIRY_DOWNLOAD=1800
R2_PRESIGNED_URL_EXPIRY_STREAM=3600

RAZORPAY_KEY_ID=rzp_test_fakekeyid
RAZORPAY_KEY_SECRET=fakerazorpaysecret
RAZORPAY_WEBHOOK_SECRET=fakewebhooksecret

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=test@test.com
SMTP_PASSWORD=testpassword
SMTP_FROM_EMAIL=noreply@speakarena.test
SMTP_FROM_NAME=SpeakArena Test

CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000
